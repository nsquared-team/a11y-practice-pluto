---
// /design-system/story/<id>/ — one story of the design system's component explorer, alone, in the
// site's CSS. GENERATED by the blinkpages-migrate skill: the stories are in
// src/components/design-system/stories.ts. The explorer on /design-system/ frames this page at the
// chosen device width; opened on its own, it is the story at the window's width.
//
// It builds in a pass of its own (src/integrations/design-system.mjs), so nothing it imports can
// change a real page (style-library.md §3). Every story page carries the same CSS, in a real page's
// order: the stylesheets of the layout most native pages use (its global sheets and its chrome's),
// then every component's, then StoryDefs.astro's. StoryDefs.astro (src/components/design-system/,
// optional) renders first on every story page: the layout's SVG filters and <defs>, and in its
// frontmatter any stylesheet a story needs that the layout doesn't load.
// `virtual:design-system/story` exists only with the integration registered in astro.config.mjs.
// @ts-ignore: the integration declares it, but a tsconfig that excludes .astro/ hides the declaration
import { component, StoryDefs } from "virtual:design-system/story";
import { fontSheets, storyPages, type StoryPage } from "../../../components/design-system/explorer";

export const prerender = true;
export function getStaticPaths() {
  return storyPages().map((page) => ({ params: { id: page.id }, props: { page } }));
}
const { page } = Astro.props as { page: StoryPage };
const Comp = page.component ? component(page.component) : undefined;

/* the story's wrapper (stories.ts `wrap`), outermost first: markup around the component, not part of it */
const attr = (s: string) => s.replace(/&/g, "&amp;").replace(/"/g, "&quot;").replace(/</g, "&lt;");
const tagOf = (t?: string) => (t && /^[a-z][a-z0-9-]*$/.test(t) ? t : "div");
const wraps = page.wrap ?? [];
const wrapOpen = wraps.map((w) => `<${tagOf(w.tag)}${w.class ? ` class="${attr(w.class)}"` : ""}${w.style ? ` style="${attr(w.style)}"` : ""}>`).join("");
const wrapClose = wraps.map((w) => `</${tagOf(w.tag)}>`).reverse().join("");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{page.title} — Design system</title>
    {fontSheets().map((href) => <link rel="stylesheet" href={href} />)}
    <style is:global>
      html, body { margin: 0; }
      /* a centered or padded story's frame fits its content: no scrollbar (a site may force one on html) */
      html:has(> body.sl-story--centered), html:has(> body.sl-story--padded) { overflow: hidden !important; }
      /* a site that paints html (paravelle.com's navy) showed it under every short atom: a centered or
         padded story sits on the frame's chosen background instead */
      html:has(> body.sl-story--centered), html:has(> body.sl-story--padded) { background: transparent; }
      .sl-story--padded { padding: 1.5rem; }
      .sl-story--centered #sl-story-root, .sl-story--centered > .sl-story-frame { display: flex; flex-wrap: wrap; justify-content: center; gap: 1rem; padding: 2.5rem 1.5rem; }
    </style>
  </head>
  <body class={`sl-story sl-story--${page.layout}`} data-pagefind-ignore="all" style={page.background ? `background:${page.background}` : undefined}>
    {StoryDefs && <StoryDefs />}
    {Comp ? (
      page.layout === "centered" ? (
        <div class="sl-story-frame"><Fragment set:html={wrapOpen} />{page.slot ? <Comp {...page.args}><Fragment set:html={page.slot} /></Comp> : <Comp {...page.args} />}<Fragment set:html={wrapClose} /></div>
      ) : (
        <Fragment><Fragment set:html={wrapOpen} />{page.slot ? <Comp {...page.args}><Fragment set:html={page.slot} /></Comp> : <Comp {...page.args} />}<Fragment set:html={wrapClose} /></Fragment>
      )
    ) : page.html !== undefined ? (
      <Fragment><Fragment set:html={wrapOpen} /><div id="sl-story-root" set:html={page.html} /><Fragment set:html={wrapClose} /></Fragment>
    ) : (
      <p>Unknown component: {page.component} (src/components/design-system/stories.ts)</p>
    )}
    <script is:inline>
      (function () {
        /* the explorer sets the background and, for an HTML story, posts new markup on each control change */
        var bg = new URLSearchParams(location.search).get("bg");
        if (bg) document.body.style.background = bg;
        var root = document.getElementById("sl-story-root");
        /* a story never posts a form or leaves its frame: submits are cancelled, and a link to
           another page does nothing (an in-page #link still works) */
        document.addEventListener("submit", function (e) { e.preventDefault(); e.stopImmediatePropagation(); }, true);
        document.addEventListener("click", function (e) {
          var a = e.target.closest && e.target.closest("a[href]");
          if (a && !/^#/.test(a.getAttribute("href"))) e.preventDefault();
        }, true);
        addEventListener("message", function (e) {
          if (e.origin !== location.origin || !e.data || e.data.type !== "sl-story") return;
          if (typeof e.data.bg === "string") document.body.style.background = e.data.bg;
          if (root && typeof e.data.html === "string") root.innerHTML = e.data.html;
        });
        /* report the content height, so a centered or padded story's frame fits it */
        if (parent === window) return;
        /* the bottom of the lowest child, not scrollHeight: that is never less than the frame, so it
           could only grow (and a site's body may have a min-height) */
        var post = function () {
          var b = 0, kids = document.body.children;
          for (var i = 0; i < kids.length; i++) if (kids[i].tagName !== "SCRIPT") b = Math.max(b, kids[i].getBoundingClientRect().bottom + scrollY);
          b += parseFloat(getComputedStyle(document.body).paddingBottom) || 0;
          parent.postMessage({ type: "sl-story-size", h: Math.ceil(b) }, location.origin);
        };
        if ("ResizeObserver" in window) { var ro = new ResizeObserver(post); for (var i = 0; i < document.body.children.length; i++) ro.observe(document.body.children[i]); }
        addEventListener("load", post);
        post();
      })();
    </script>
  </body>
</html>
