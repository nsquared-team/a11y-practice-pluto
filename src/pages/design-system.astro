    <meta name="design-system-build" content={built} />
    <title>Design System — {siteName}</title>
    {/* the site's fonts, as its layouts load them (fontSheets), and its self-hosted fonts sheet (the glob above) */}
    {[...new Set([...fontSheets, ...cssImports])].map((href) => <link rel="stylesheet" href={href} />)}
    <style is:inline set:html={siteInline} />
    <style>
      /* set in the brand's own type and colors (DESIGN.md → --bb-* on .sl), so the page reads as the brand */
      /* a unitless line height: a site's em line height on body arrives as a fixed length and
         double-spaced the captions (electriccollab.com) */
