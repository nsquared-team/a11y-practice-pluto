    <style is:global>
      /* ---- DESIGN.md's prose, set from its markdown (set:html, so these rules are global): lists, ###
         subheads, tables and code, in the book's own type ---- */
      .bb-prose p { margin: 0 0 1em; break-inside: avoid; }
      .bb-prose .bb-prose-h { margin: 1.5em 0 .625em; padding: 0; color: inherit; font: 600 .75rem/1.3 var(--bb-text, system-ui, sans-serif); letter-spacing: .14em; text-transform: uppercase; break-after: avoid; }
      .bb-prose .bb-prose-h:first-child { margin-top: 0; }
      .bb-list, .bb-list ul, .bb-list ol { margin: 0 0 1em; padding: 0; }
      .bb-list ul, .bb-list ol { margin: .4em 0 0; }
      .bb-list li { margin: 0 0 .4em; break-inside: avoid; }
      ul.bb-list, .bb-list ul { list-style: none; }
      ul.bb-list > li, .bb-list ul > li { position: relative; padding-left: 1.4em; }
      ul.bb-list > li::before, .bb-list ul > li::before { content: "—"; position: absolute; left: 0; color: var(--bb-accent); }
      ol.bb-list, .bb-list ol { padding-left: 1.6em; list-style: decimal; }
      ol.bb-list > li::marker, .bb-list ol > li::marker { font-weight: 600; font-variant-numeric: tabular-nums; }
      /* a table or a code block spans the prose's two columns, and scrolls sideways on a phone */
      .bb-table-wrap, .bb-pre, .bb-prose .bb-lead { column-span: all; }
      /* the columns above a spanning block lose their last margin at the break: the lead keeps a gap */
      .bb-prose .bb-lead:not(:first-child) { margin-top: 1.25em; }
      .bb-table-wrap { margin: .75rem 0 2rem; overflow-x: auto; }
      .bb-table-wrap:last-child { margin-bottom: 1em; }
      /* the site's own table rules (a border, stripes) never reach the book's */
      .bb-table { width: 100%; margin: 0; border: 0; border-collapse: collapse; background: none; font-size: .9375rem; line-height: 1.5; }
      .bb-table th, .bb-table td { border: 0; background: none; }
      .bb-table th { padding: 0 1.25rem .625rem 0; border-bottom: 2px solid var(--bb-ink, #1a1a1a); color: inherit; font: 600 .6875rem/1.3 var(--bb-text, system-ui, sans-serif); letter-spacing: .12em; text-align: left; text-transform: uppercase; vertical-align: bottom; }
      .bb-table td { padding: .75rem 1.25rem .75rem 0; border-bottom: 1px solid #e5e5e5; vertical-align: top; }
      .bb-table th:last-child, .bb-table td:last-child { padding-right: 0; }
      .bb-pre { margin: .75rem 0 1.75rem; padding: 1rem 1.25rem; overflow-x: auto; border-radius: 6px; background: #f6f7f9; font: .8125rem/1.55 ui-monospace, SFMono-Regular, Menlo, monospace; white-space: pre; }
      /* ---- the Logo chapter: a small icon (favicon-32, favicon.ico) at twice its size; the cover's mark on
         a paper tile, or rounded as an app icon when it paints its own ground ---- */
      .bb-mark--small img { width: 64px; height: 64px; }
      /* a tile's color-scheme matches its ground, so a scheme-adaptive SVG icon (Astro's starter
         favicon.svg turns white under prefers-color-scheme: dark) stays visible on a light tile in a dark
         OS (canary, alignwithjessica.com and one more; checked in Chrome 149) */
      .bb-cover-mark--tile { box-sizing: border-box; padding: 12px; border-radius: 16px; background: var(--bb-paper); color-scheme: light; }
      .bb-cover-mark--app { border-radius: 16px; }
      /* ---- the explorer: a list or object prop, summarized, its JSON a click away; a named union's values ---- */
      .sx-value > summary { color: #374151; font: .75rem/1.5 ui-monospace, SFMono-Regular, Menlo, monospace; cursor: pointer; }
      /* the JSON keeps its lines and scrolls inside the cell: no min-content width of its own (width 0, at
         least the cell), so a long line never widens the table past the panel on a phone */
      .sx-value .sx-code { box-sizing: border-box; width: 0; min-width: 100%; max-height: 18rem; margin-top: .5rem; padding: .75rem 1rem; overflow: auto; }
      @media (max-width: 600px) { .sx-value .sx-code { white-space: pre; word-break: normal; } }
      .sx-resolved { color: #6b7280; }
    </style>
    <script is:inline>
      (function () {
        /* forms never post: the guard enables the fields, keeps submit disabled, and cancels any
           submit before the form's own handler sees it */
        document.querySelectorAll("[data-sl-form-guard]").forEach(function (g) {
          g.addEventListener("submit", function (e) { e.preventDefault(); e.stopImmediatePropagation(); }, true);
          g.removeAttribute("disabled");
          g.querySelectorAll('[type="submit"]').forEach(function (b) { b.disabled = true; b.title = "Disabled on the design system page"; });
        });
        /* a link to #block-x or #tokens-color opens that card (and any card around it) */
        function openTo(id) {
          var el = id && document.getElementById(decodeURIComponent(id));
          if (!el) return;
          for (var d = el; d; d = d.parentElement) if (d.tagName === "DETAILS") d.open = true;
          el.scrollIntoView();
        }
        openTo(location.hash.slice(1));
        addEventListener("hashchange", function () { openTo(location.hash.slice(1)); });
        document.querySelectorAll("[data-sl-toggle]").forEach(function (b) {
          b.addEventListener("click", function () {
            var open = b.getAttribute("data-sl-toggle") === "open";
            document.querySelectorAll(b.getAttribute("data-sl-scope") + " details").forEach(function (d) { d.open = open; });
          });
        });
        /* mark the section in view in the sidebar */
        var links = {};
        document.querySelectorAll("[data-sl-nav]").forEach(function (a) { links[a.getAttribute("data-sl-nav")] = a; });
        if ("IntersectionObserver" in window) {
          var io = new IntersectionObserver(function (entries) {
            entries.forEach(function (e) {
              if (!e.isIntersecting) return;
              Object.keys(links).forEach(function (k) { links[k].classList.toggle("is-current", k === e.target.id); });
              /* on phones the contents are a scrolling strip: keep the current entry in it */
              var nav = links[e.target.id] && links[e.target.id].parentElement;
              if (nav && nav.scrollWidth > nav.clientWidth) nav.scrollLeft = links[e.target.id].offsetLeft - 16;
            });
          }, { rootMargin: "0px 0px -70% 0px" });
          Object.keys(links).forEach(function (k) { var s = document.getElementById(k); if (s) io.observe(s); });
        }
      })();
    </script>
    <script is:inline>
      /* the component explorer: frames a story's page (or, in "All stories", every story of the
         component) at a device width, and builds the Controls, Props, Code and Used-on panels from
         the JSON explorer.ts wrote */
      (function () {
        var dataEl = document.getElementById("sx-data"), root = document.querySelector("[data-sx]");
        if (!dataEl || !root) return;
        var D = JSON.parse(dataEl.textContent), byKey = {}, keys = [];
        D.entries.forEach(function (e) { e.stories.forEach(function (st) { byKey[e.slug + "/" + st.slug] = { e: e, st: st }; keys.push(e.slug + "/" + st.slug); }); });
        var $ = function (s) { return root.querySelector(s); };
        var canvas = $("[data-sx-canvas]"), panel = $("[data-sx-panel]"), open = $("[data-sx-open]");
        var VP = { phone: [390, 844], tablet: [768, 1024], desktop: [1440, 900] };
        var S = { e: null, st: null, values: {}, vp: "fit", bg: "", tab: "controls", mode: "story" }, cells = [];
        var esc = function (s) { return String(s == null ? "" : s).replace(/[&<>"]/g, function (c) { return { "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" }[c]; }); };
        var postTo = function (c, m) { m.type = "sl-story"; try { c.frame.contentWindow.postMessage(m, location.origin); } catch (_) {} };

        /* an HTML story's markup for a set of args (explorer.ts's renderHtml, in the browser) */
        function htmlOf(values) {
          var c = S.e.controls;
          return S.e.html.replace(/\{\{\s*([\w-]+)\s*\}\}/g, function (_, k) {
            var ctl = c[k], v = values[k];
            if (ctl && ctl.type === "boolean") return v ? ctl.on : ctl.off || "";
            return !ctl || ctl.type === "text" ? esc(v) : String(v == null ? "" : v);
          });
        }
        /* the page of a cell: the story's own, or (one story, a component) the combination the controls chose */
        function idOf(c) {
          if (S.mode === "all" || S.e.kind === "html") return c.st.combos[0].id;
          var hit = c.st.combos.filter(function (x) { return Object.keys(x.values).every(function (k) { return x.values[k] === S.values[k]; }); })[0];
          return hit ? hit.id : null;
        }
        function href(id) { return D.base + id + (D.tail ?? "/") + (S.bg ? "?bg=" + encodeURIComponent(S.bg) : ""); }
        function load(c) {
          var id = idOf(c);
          if (!id) return false;
          if (id !== c.id) { c.id = id; c.h = 160; c.frame.src = href(id); size(c); }
          if (S.mode === "story") open.href = href(id);
          return true;
        }
        function size(c) {
          var full = c.st.layout === "fullscreen", avail = canvas.clientWidth - (innerWidth < 900 ? 24 : 40), vp = VP[S.vp];
          var fitW = S.mode === "all" && !full && cells.length > 1 && avail > 640 ? Math.floor((avail - 24) / 2) : avail;
          var w = vp ? vp[0] : fitW, h = full ? (vp ? vp[1] : Math.min(900, Math.round(innerHeight * .8))) : c.h;
          var k = Math.min(1, (vp ? avail : fitW) / w);
          c.frame.style.width = w + "px"; c.frame.style.height = h + "px"; c.frame.style.transform = k < 1 ? "scale(" + k + ")" : "";
          c.wrap.style.width = Math.floor(w * k) + "px"; c.wrap.style.height = Math.ceil(h * k) + "px";
          $("[data-sx-scale]").textContent = k < 1 ? "shown at " + Math.round(k * 100) + "%" : "";
        }
        /* each frame is named blink-compare:story before its src is set: the BlinkPages editor stays dormant in
           a frame named blink-compare:… (the marker of its own compare panes), so a signed-in editor sees the
           story, not a second admin bar inside it. "story" is no compare role, so no compare bridge starts. */
        function build() {
          var list = S.mode === "all" ? S.e.stories : [S.st];
          canvas.classList.toggle("sx-canvas--all", S.mode === "all");
          canvas.innerHTML = list.map(function (st) {
            return '<figure class="sx-cell">' + (S.mode === "all" ? '<figcaption class="sx-cell-name">' + esc(st.name) + "</figcaption>" : "") +
              '<div class="sx-frame-wrap"><iframe class="sx-frame" name="blink-compare:story" title="' + esc(S.e.title + " · " + st.name) + '" loading="lazy"></iframe></div></figure>';
          }).join("");
          cells = list.map(function (st, i) {
            var fig = canvas.children[i], c = { st: st, frame: fig.querySelector("iframe"), wrap: fig.querySelector(".sx-frame-wrap"), h: 160, id: "" };
            c.frame.addEventListener("load", function () {
              if (S.e.kind === "html") postTo(c, { html: htmlOf(S.mode === "all" ? c.st.args : S.values) });
              if (S.bg) postTo(c, { bg: S.bg });
            });
            return c;
          });
          cells.forEach(function (c) { load(c); size(c); });
          open.hidden = S.mode === "all";
        }
        function controlsHtml() {
          var e = S.e, rows = [];
          if (S.mode === "all") return '<p class="sx-note">Every story of ' + esc(e.title) + ", each with its own props. Choose one in the list to change its controls.</p>";
          if (e.kind === "html") {
            Object.keys(e.controls).forEach(function (k) {
              var c = e.controls[k], v = S.values[k], input;
              if (c.type === "select") input = '<select data-sx-ctl="' + esc(k) + '">' + Object.keys(c.options).map(function (label) { var val = c.options[label]; return '<option value="' + esc(val) + '"' + (val === (v == null ? "" : v) ? " selected" : "") + ">" + esc(label) + "</option>"; }).join("") + "</select>";
              else if (c.type === "boolean") input = '<label><input type="checkbox" data-sx-ctl="' + esc(k) + '"' + (v ? " checked" : "") + '> <span class="sx-note">adds <code>.' + esc(c.on) + "</code></span></label>";
              else input = '<input type="text" data-sx-ctl="' + esc(k) + '" value="' + esc(v) + '">';
              rows.push('<tr><th scope="row">' + esc(k) + "</th><td>" + input + "</td></tr>");
            });
          } else {
            e.props.forEach(function (p) {
              var v = S.values[p.name], a = S.st.args[p.name], input, dflt = p.default && p.default.replace(/^(["'`])(.*)\1$/, "$2");
              /* an optional enum can stay unset ("(not set)", the component's own default); the default option says so */
              if (p.control === "select") input = '<select data-sx-ctl="' + esc(p.name) + '">' + (p.unset ? "<option data-sx-unset" + (v === null ? " selected" : "") + ">(not set)</option>" : "") + p.options.map(function (o) { return '<option value="' + esc(o) + '"' + (o === v ? " selected" : "") + ">" + esc(o) + (o === dflt ? " (default)" : "") + "</option>"; }).join("") + "</select>";
              else if (p.control === "boolean") input = '<label><input type="checkbox" data-sx-ctl="' + esc(p.name) + '"' + (v ? " checked" : "") + "></label>";
              else input = a === undefined ? '<span class="sx-note">' + (p.default !== undefined ? "default " + esc(p.default) : "not set") + "</span>" : valueHtml(a);
              rows.push('<tr><th scope="row">' + esc(p.name) + "</th><td>" + input + "</td></tr>");
            });
          }
          if (!rows.length) return '<p class="sx-note">' + (e.kind === "html" ? "No controls." : "This component takes no props: it renders the same wherever it is used. Its variants are its device widths: try Phone, Tablet and Desktop above.") + "</p>";
          return '<table class="sx-table"><tbody>' + rows.join("") + "</tbody></table>" + (e.kind === "component"
            ? '<p class="sx-note">A list or a switch shows each pre-rendered combination. Text props show the story\'s sample copy.</p><p class="sx-note" data-sx-miss hidden>That combination is not pre-rendered: past 24 combinations the explorer renders one change at a time from the story. Change one control from the story\'s own values.</p>'
            : "");
        }
        /* a prop's value, readable: short text inline; a list or an object summarized by its size and keys,
           its JSON a click away (a case study's props printed 600 characters on one line, evgnagency 2026-11-03).
           Only an enum or a switch re-renders a component here, so these are shown, not edited */
        function keysOf(o) { var k = Object.keys(o); return "{ " + k.slice(0, 6).map(esc).join(", ") + (k.length > 6 ? ", … " + (k.length - 6) + " more" : "") + " }"; }
        function valueHtml(a) {
          var json = typeof a === "string" ? a : JSON.stringify(a, null, 2), sum;
          if (Array.isArray(a)) sum = a.length + (a.length === 1 ? " item" : " items") + (a[0] && typeof a[0] === "object" && !Array.isArray(a[0]) ? ", each " + keysOf(a[0]) : "");
          else if (a && typeof a === "object") sum = keysOf(a);
          else if (json.length <= 90) return "<code>" + esc(json) + "</code>";
          else sum = esc(json.slice(0, 72)) + "…";
          return '<details class="sx-value"><summary>' + sum + '</summary><pre class="sx-code">' + esc(json) + "</pre></details>";
        }
        function propsHtml() {
          var e = S.e;
          if (e.kind === "html") return '<table class="sx-table"><thead><tr><th>Control</th><th>Kind</th><th>Values</th></tr></thead><tbody>' + Object.keys(e.controls).map(function (k) { var c = e.controls[k]; return "<tr><td><code>" + esc(k) + "</code></td><td>" + esc(c.type) + "</td><td>" + (c.type === "select" ? Object.keys(c.options).map(function (l) { return esc(l) + " <code>" + esc(c.options[l] || "(none)") + "</code>"; }).join(", ") : c.type === "boolean" ? "adds <code>." + esc(c.on) + "</code>" : "text") + "</td></tr>"; }).join("") + '</tbody></table><p class="sx-note">Markup and global classes, no component: the Code tab has the markup.</p>';
          if (!e.props.length) return '<p class="sx-note"><code>' + esc(e.component) + "</code> declares no props.</p>";
          return '<table class="sx-table"><thead><tr><th>Name</th><th>Type</th><th>Default</th><th>Description</th></tr></thead><tbody>' + e.props.map(function (p) { return "<tr><td><code>" + esc(p.name) + (p.optional ? "?" : "") + "</code></td><td><code>" + esc(p.type) + "</code>" + (p.resolved ? '<br><code class="sx-resolved">' + esc(p.resolved) + "</code>" : "") + "</td><td>" + (p.default !== undefined ? "<code>" + esc(p.default) + "</code>" : "—") + "</td><td>" + esc(p.description || "") + "</td></tr>"; }).join("") + "</tbody></table>";
        }
        function codeOf(st, values) {
          var e = S.e;
          if (e.kind === "html") return htmlOf(values);
          var name = e.component.split("/").pop().replace(/\.astro$/, ""), args = Object.assign({}, st.args, values);
          /* an enum left unset is left out; a long list or object is set out over lines, one attribute a line */
          var attrs = Object.keys(args).filter(function (k) { return args[k] !== null && args[k] !== undefined; }).map(function (k) {
            var v = args[k], j = JSON.stringify(v);
            return v === true ? k : v === false ? k + "={false}" : typeof v === "string" ? k + '="' + v.replace(/"/g, "&quot;") + '"' : k + "={" + (j.length > 60 ? JSON.stringify(v, null, 2).replace(/\n/g, "\n  ") : j) + "}";
          });
          var tall = attrs.some(function (x) { return x.indexOf("\n") !== -1; });
          return "<" + name + (attrs.length ? (tall ? "\n  " + attrs.join("\n  ") + "\n" : " " + attrs.join(" ")) : "") + (st.slot ? ">" + st.slot + "</" + name + ">" : tall ? "/>" : " />");
        }
        function codeText() {
          var e = S.e, head = e.kind === "component" ? "import " + e.component.split("/").pop().replace(/\.astro$/, "") + ' from "../components/' + e.component + '";\n\n' : "";
          if (S.mode === "all") return head + e.stories.map(function (st) { return (e.kind === "html" ? "<!-- " : "{/* ") + st.name + (e.kind === "html" ? " -->" : " */}") + "\n" + codeOf(st, e.kind === "html" ? st.args : st.combos[0].values); }).join("\n\n");
          return head + codeOf(S.st, S.values);
        }
        function render() {
          var e = S.e, t = S.tab;
          root.querySelectorAll("[data-sx-tab]").forEach(function (b) { b.setAttribute("aria-selected", String(b.getAttribute("data-sx-tab") === t)); });
          panel.innerHTML = t === "controls" ? controlsHtml() : t === "props" ? propsHtml()
            : t === "code" ? '<div class="sx-codebox"><button type="button" class="sx-copy" data-sx-copy>Copy</button><pre class="sx-code">' + esc(codeText()) + "</pre></div>"
            : e.usedOn.length ? '<ul class="sx-used">' + e.usedOn.map(function (u) { return "<li>" + (u.href ? '<a href="' + esc(u.href) + '">' + esc(u.label) + "</a>" : esc(u.label)) + "</li>"; }).join("") + "</ul>"
            : '<p class="sx-note">' + (e.kind === "html" ? "Global classes: any page may use this markup." : "No page imports it yet.") + "</p>";
        }
        function press(attr, val) { root.querySelectorAll("[" + attr + "]").forEach(function (b) { b.setAttribute("aria-pressed", String(b.getAttribute(attr) === val)); }); }
        function select(key, mode, user) {
          var hit = byKey[key] || byKey[keys[0]];
          if (!hit) return;
          S.e = hit.e; S.st = hit.st; S.mode = mode;
          S.values = Object.assign({}, hit.e.kind === "html" ? hit.st.args : hit.st.combos[0].values);
          S.vp = hit.st.layout === "fullscreen" ? "desktop" : "fit";
          var k = hit.e.slug + "/" + hit.st.slug;
          root.querySelectorAll("[data-sx-story]").forEach(function (a) { var on = mode === "story" && a.getAttribute("data-sx-story") === k; a.classList.toggle("is-current", on); if (on) a.setAttribute("aria-current", "true"); else a.removeAttribute("aria-current"); });
          root.querySelectorAll("[data-sx-all]").forEach(function (b) { b.classList.toggle("is-current", mode === "all" && b.getAttribute("data-sx-all") === hit.e.slug); });
          $("[data-sx-crumb]").textContent = hit.e.group + (mode === "all" ? "" : " / " + hit.e.title);
          $("[data-sx-title]").textContent = mode === "all" ? hit.e.title : hit.st.name;
          $("[data-sx-desc]").textContent = [hit.e.description, mode === "all" ? "" : hit.st.note].filter(Boolean).join(" ");
          press("data-sx-vp", S.vp); press("data-sx-mode", mode);
          build(); render();
          if (user && history.replaceState) history.replaceState(null, "", "#explorer/" + (mode === "all" ? hit.e.slug : k));
        }

        addEventListener("message", function (ev) {
          if (!ev.data || ev.data.type !== "sl-story-size") return;
          cells.forEach(function (c) { if (ev.source === c.frame.contentWindow) { c.h = Math.max(96, Math.ceil(ev.data.h)); size(c); } });
        });
        addEventListener("resize", function () { cells.forEach(size); });
        root.addEventListener("click", function (ev) {
          var t = ev.target.closest ? ev.target.closest("[data-sx-story],[data-sx-all],[data-sx-mode],[data-sx-vp],[data-sx-bg],[data-sx-tab],[data-sx-copy]") : null;
          if (!t) return;
          if (t.hasAttribute("data-sx-story")) { ev.preventDefault(); select(t.getAttribute("data-sx-story"), "story", true); }
          else if (t.hasAttribute("data-sx-all")) { var e = D.entries.filter(function (x) { return x.slug === t.getAttribute("data-sx-all"); })[0]; if (e) select(e.slug + "/" + e.stories[0].slug, "all", true); }
          else if (t.hasAttribute("data-sx-mode")) select(S.e.slug + "/" + S.st.slug, t.getAttribute("data-sx-mode"), true);
          else if (t.hasAttribute("data-sx-vp")) { S.vp = t.getAttribute("data-sx-vp"); press("data-sx-vp", S.vp); cells.forEach(size); }
          else if (t.hasAttribute("data-sx-bg")) { S.bg = t.getAttribute("data-sx-bg"); press("data-sx-bg", S.bg); cells.forEach(function (c) { postTo(c, { bg: S.bg || c.st.background || "" }); }); if (cells[0] && cells[0].id) open.href = href(cells[0].id); }
          else if (t.hasAttribute("data-sx-tab")) { S.tab = t.getAttribute("data-sx-tab"); render(); }
          else if (navigator.clipboard) navigator.clipboard.writeText(codeText()).then(function () { t.textContent = "Copied"; });
        });
        function onControl(ev) {
          var t = ev.target, k = t.getAttribute && t.getAttribute("data-sx-ctl");
          if (!k || !cells[0]) return;
          S.values[k] = t.type === "checkbox" ? t.checked : t.selectedOptions && t.selectedOptions[0] && t.selectedOptions[0].hasAttribute("data-sx-unset") ? null : t.value;
          if (S.e.kind === "html") { postTo(cells[0], { html: htmlOf(S.values) }); return; }
          if (ev.type !== "change") return;
          var miss = panel.querySelector("[data-sx-miss]"), ok = load(cells[0]);
          if (miss) miss.hidden = ok;
        }
        panel.addEventListener("input", onControl);
        panel.addEventListener("change", onControl);
        $("[data-sx-search]").addEventListener("input", function (ev) {
          var q = ev.target.value.trim().toLowerCase();
          root.querySelectorAll("[data-sx-entry]").forEach(function (el) { el.hidden = q !== "" && el.getAttribute("data-sx-text").indexOf(q) === -1; });
          root.querySelectorAll("[data-sx-group]").forEach(function (g) { g.hidden = !g.querySelector("[data-sx-entry]:not([hidden])"); });
        });
        /* #explorer/<component> opens All stories, #explorer/<component>/<story> one story */
        function fromHash() {
          if (location.hash.indexOf("#explorer/") !== 0) return null;
          var k = decodeURIComponent(location.hash.slice(10));
          if (byKey[k]) return [k, "story"];
          var e = D.entries.filter(function (x) { return x.slug === k; })[0];
          return e ? [e.slug + "/" + e.stories[0].slug, "all"] : null;
        }
        addEventListener("hashchange", function () { var h = fromHash(); if (h) { select(h[0], h[1], false); document.getElementById("explorer").scrollIntoView(); } });
        var start = fromHash();
        select(start ? start[0] : keys[0], start ? start[1] : "story", false);
        if (start) document.getElementById("explorer").scrollIntoView();
      })();
    </script>
  </body>
</html>
