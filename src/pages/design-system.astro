      .sl-nav-home { font-family: var(--bb-display, inherit); font-size: 1.125rem; font-weight: 400; }
      .sl-nav-label { margin: 1.25rem .625rem .25rem; color: #6b7280; font-size: .6875rem; font-weight: 600; letter-spacing: .08em; text-transform: uppercase; }
      .sl-nav-sub a { padding-left: 1.5rem; font-size: .8125rem; color: #555; }
      .sl-main { min-width: 0; max-width: none; margin: 0; padding: 2rem 2.5rem 6rem; }
      .sl-main section, .sx { scroll-margin-top: 1rem; }
