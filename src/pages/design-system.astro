---
// design-system template: 60a48fe
//   (the blinkpages-migrate commit this page was copied or last updated from; whoever copies or
//   updates the page writes it here, so the next update 3-way merges from the right base)
// /design-system — the site's brand book and design system, ONE document (style-library.md §3).
//
// DESIGN.md (repo root, Google's design.md format) is the spec: tokens, roles, intent, do's and don'ts.
// This page sets it out for a person, as one book in DESIGN.md's own order (the person's choice,
// 2026-11-02: one place for each thing, for designers and agents alike):
//   cover and Overview · 01 Logo & icon · 02 Color · 03 Typography · 04 Layout · 05 Depth & shape ·
//   06 Components (the Storybook-style explorer) · 07 Do's & don'ts.
// Each chapter opens with DESIGN.md's own prose for it, verbatim, then shows it once: swatches, the
// pairs in use, the hierarchy and specimens, the drawn grid, the corners, the components. A
// collapsed "For developers" strip at a chapter's foot gives its tokens and classes; the APPENDIX
// lists what the explorer leaves out, every token and every global class.
// Nothing here writes new copy, and nothing renders a page's real copy.
//
// Internal: noindexed here, kept out of the sitemap (astro.config.mjs), and login-gated on the
// platform (the fleet default adminRoutePrefixes lists /design-system; a tenant's own list must too).
//
// GENERATED parts read tokens.css, global.css, DESIGN.md and the explorer's stories at build time,
// so don't hand-edit them. DESIGN.md is checked against tokens.css by drift.mjs beside this page: the
// gate's own check (scripts/lib/design-drift.mjs), copied by the scaffold, never edited here.
// The CURATED parts (the sl:logos,
// sl:typography, sl:layout, sl:elevation, sl:shapes and sl:components slots, slOmit, and the stories in
// src/components/design-system/stories.ts) belong to the style-library agent
// (oneshot/briefs/style-library.md). Each marker shows the markup to use.
//
// gate-style-library.mjs fails the run when DESIGN.md is missing or disagrees with tokens.css, when a
// token or global class is missing here (or from the story pages), or when a component a native page
// imports has no story and no slOmit reason.
//
// This page and its story pages build in a pass of their own (src/integrations/design-system.mjs,
// registered in astro.config.mjs): the site's own build sees them as empty stubs, so what they import
// never changes a real page's CSS (style-library.md §3). The page says so in
// <meta name="design-system-build" content="pass">, which the gate checks.
import fs from "node:fs";
import path from "node:path";
// @ts-ignore: the integration declares it, but a tsconfig that excludes .astro/ hides the declaration
import { built } from "virtual:design-system/build";
/* tokens.css and global.css are set inline in <head> (?inline: Vite's processed text, url()s and
   @imports resolved), never imported as CSS modules. Imported, they became a chunk the separate pass
   shared with the story route, and on story pages it landed after the layout's later sheets, so
   global.css's older rules beat the live look (noonanelectricalservices.com, andrewpickettlaw.com,
   855mikewins.com, 2026-11-04) */
import tokensInline from "../styles/tokens.css?inline";
import globalInline from "../styles/global.css?inline";
/* an @import must open its sheet, so one in global.css (a Google Fonts url()) was ignored once the
   inlined text followed tokens.css (syntropymarketing.com's Manrope, Roboto, Space Mono, Figtree fell
   back to system faces). External imports become <link>s in <head>, ahead of the inlined text */
const importRe = /@import\s+(?:url\(\s*)?["']?(https?:\/\/[^"')\s]+)["']?\s*\)?[^;]*;/g;
const cssImports = [...new Set([...`${tokensInline}\n${globalInline}`.matchAll(importRe)].map((m) => m[1]))];
const siteInline = `${tokensInline}\n${globalInline}`.replace(importRe, "");
/* the site's self-hosted fonts, when it has a fonts sheet: the brand book is set in them */
import.meta.glob("../styles/**/fonts*.css", { eager: true });
import tokensCss from "../styles/tokens.css?raw";
import { designDrift, tokenNames, tokenOf } from "../components/design-system/drift.mjs";
import globalCss from "../styles/global.css?raw";
/* curated imports go here (this page builds apart from the real pages, so an import changes none of them) */

/* Components a native page imports that the explorer does not show, each with the reason
   (gate-style-library.mjs reads this object): one that only opens from another ("opens from a project
   card: open one in the Projects story"), or one that must not run even alone ("posts on load").
   Shown in the appendix as "Not in the explorer". */
const slOmit: Record<string, string> = {};

/* Older pages only: the Blocks appendix's card groups, [id, label]. A new page leaves this empty, as
   its blocks are stories (stories.ts), and the Blocks appendix then does not render. */
const slBlockGroups: [string, string][] = [];

/* DESIGN.md, if the site has one yet (a glob, so a site without it still builds) */
const designSrc = Object.values(import.meta.glob<string>("/DESIGN.md", { query: "?raw", import: "default", eager: true }))[0] ?? "";

const stripComments = (css: string) => css.replace(/\/\*[\s\S]*?\*\//g, "");

/* every `--name: value` (first value wins), in source order */
function tokensOf(css: string) {
  const out = new Map<string, string>();
  for (const m of stripComments(css).matchAll(/(--[A-Za-z0-9_-]+)\s*:\s*([^;{}]+);/g)) {
    if (!out.has(m[1])) out.set(m[1], m[2].trim());
  }
  return [...out].map(([name, value]) => ({ name, value }));
}

/* every class named in a selector (at-rule preludes skipped), in source order */
function classesOf(css: string) {
  const out = new Set<string>();
  for (const m of stripComments(css).matchAll(/([^{}]+)\{/g)) {
    const sel = m[1].trim();
    if (!sel || sel.startsWith("@")) continue;
    for (const c of sel.replace(/\[[^\]]*\]/g, "").matchAll(/\.(-?[A-Za-z_][A-Za-z0-9_-]*)/g)) out.add(c[1]);
  }
  return [...out];
}

type Kind = "color" | "gradient" | "font" | "size" | "weight" | "leading" | "tracking" | "space" | "radius" | "shadow" | "other";
const COLOR_VALUE = /^(#|rgba?\(|hsla?\(|oklch\(|oklab\(|lab\(|lch\(|color-mix\(|color\()/i;
const HSL_TRIPLET = /^-?[\d.]+\s*,\s*[\d.]+%\s*,\s*[\d.]+%$/;
function kindOf({ name, value }: { name: string; value: string }): Kind {
  const n = name.toLowerCase();
  /* before color: a --hero-bg gradient is painted, never filed under "other" or read as a palette color */
  if (/gradient\(/i.test(value) || (/gradient/.test(n) && /^var\(/i.test(value))) return "gradient";
  if (COLOR_VALUE.test(value) || HSL_TRIPLET.test(value) || /colou?r|-bg\b|background|-fg\b|-ink\b|-surface/.test(n)) return "color";
  /* a family is a stack, never a number or length: advisorevolved.com's --font-scale-responsive: 0.15vw
     and a fleet site's --font-primary-line-height: 120% were filed as families; ninebark's and
     raytrammell's --f-display, a quoted stack, as a size */
  const lengthy = /^-?[\d.]+[a-z%]*$/i.test(value.trim());
  if (!lengthy && !/^--font-scale/.test(n) && (/font-family|-font$|^--font(?!-size|-weight|-scale)|family/.test(n) || (/^--f-/.test(n) && /["',]/.test(value)))) return "font";
  if (/weight/.test(n)) return "weight";
  /* before size: --tracking-display / --tracking-h2 name a type tier but are letter-spacing */
  if (/tracking|letter-spacing|kerning/.test(n)) return "tracking";
  if (/leading|line-height|lh\b/.test(n)) return "leading";
  if (/shadow|^--sh-/.test(n)) return "shadow";
  if (/radius|rounded/.test(n)) return "radius";
  if (/text|font-size|fs-|size|display|heading|h[1-6]\b/.test(n)) return "size";
  if (/space|gap|pad|margin|gutter|width|max|inset|offset|height/.test(n)) return "space";
  return "other";
}
/* a Squarespace-style `--x-hsl: h,s%,l%` triplet is drawn as hsl(var(--x)) */
const paint = (t: { name: string; value: string }) => (HSL_TRIPLET.test(t.value) ? `hsl(var(${t.name}))` : `var(${t.name})`);

/* ---- DESIGN.md: the YAML front matter subset its template uses (nested maps, `key: value  # note`) ---- */
type Scalar = { value: string; comment?: string };
type YamlMap = Map<string, YamlMap | Scalar>;
const isMap = (v: unknown): v is YamlMap => v instanceof Map;
function parseFrontMatter(src: string): YamlMap {
  const root: YamlMap = new Map();
  const stack: { indent: number; node: YamlMap }[] = [{ indent: -1, node: root }];
  for (const line of (src.match(/^---\r?\n([\s\S]*?)\r?\n---/)?.[1] ?? "").split(/\r?\n/)) {
    const m = line.trim().match(/^([\w.-]+):\s*(.*)$/);
    if (!m || line.trim().startsWith("#")) continue;
    const indent = line.length - line.trimStart().length;
    while (stack.length > 1 && indent <= stack[stack.length - 1].indent) stack.pop();
    const parent = stack[stack.length - 1].node;
    const [, key, rest] = m;
    if (!rest || rest.startsWith("#")) {
      const child: YamlMap = new Map();
      parent.set(key, child);
      stack.push({ indent, node: child });
      continue;
    }
    const q = rest.match(/^"((?:[^"\\]|\\.)*)"\s*(?:#\s*(.*))?$/) ?? rest.match(/^'([^']*)'\s*(?:#\s*(.*))?$/);
    const hash = rest.search(/\s#/);
    parent.set(key, q ? { value: q[1], comment: q[2]?.trim() } : hash === -1 ? { value: rest.trim() } : { value: rest.slice(0, hash).trim(), comment: rest.slice(hash).replace(/^\s#\s*/, "").trim() });
  }
  return root;
}
const scalars = (root: YamlMap, key: string) => [...((root.get(key) as YamlMap | undefined) ?? new Map())].filter((e): e is [string, Scalar] => !isMap(e[1]));
const groupsOf = (root: YamlMap, key: string) =>
  [...((root.get(key) as YamlMap | undefined) ?? new Map())]
    .filter((e): e is [string, YamlMap] => isMap(e[1]))
    .map(([n, m]) => [n, Object.fromEntries([...m].filter((p): p is [string, Scalar] => !isMap(p[1])).map(([k, v]) => [k, v.value]))] as [string, Record<string, string>]);
const textOf = (root: YamlMap, key: string) => { const v = root.get(key); return v && !isMap(v) ? v.value : ""; };
const norm = (v?: string) => (v ?? "").toLowerCase().replace(/\s+/g, "").replace(/^#([0-9a-f])([0-9a-f])([0-9a-f])$/, "#$1$1$2$2$3$3");
const resolveRef = (root: YamlMap, ref?: string) => {
  const m = ref?.match(/^\{(\w+)\.([\w-]+)\}$/);
  if (!m) return ref;
  const v = (root.get(m[1]) as YamlMap | undefined)?.get(m[2]);
  return v && !isMap(v) ? v.value : undefined;
};
function contrast(fg: string, bg: string) {
  const rgb = (c: string) => {
    const m = c.match(/rgba?\(\s*([\d.]+)[ ,]+([\d.]+)[ ,]+([\d.]+)/);
    if (m) return [+m[1], +m[2], +m[3]];
    const h = norm(c).replace("#", "");
    return [0, 2, 4].map((i) => parseInt(h.slice(i, i + 2), 16));
  };
  const lum = (c: number[]) => {
    const [r, g, b] = c.map((x) => { const s = x / 255; return s <= 0.03928 ? s / 12.92 : ((s + 0.055) / 1.055) ** 2.4; });
    return 0.2126 * r + 0.7152 * g + 0.0722 * b;
  };
  const [a, b] = [lum(rgb(fg)), lum(rgb(bg))];
  return (Math.max(a, b) + 0.05) / (Math.min(a, b) + 0.05);
}

const tokens = tokensOf(tokensCss);
const live = new Map(tokens.map((t) => [t.name, t.value]));
/* a token and its value, for a curated caption: {tok("--color-rule")} reads tokens.css at build, so a
   caption never retypes a value that could then go stale */
const tok = (name: string) => `${name} · ${live.get(name) ?? "not in tokens.css"}`;
const design = parseFrontMatter(designSrc);
const designColors = scalars(design, "colors");
/* a DESIGN.md comment without its leading token (`= --color-ink. Body text` reads "Body text") */
const noteOf = (comment?: string) => (comment ?? "").replace(/^=?\s*--[\w-]+\.?\s*/, "");
/* each color token's DESIGN.md note and the role names that alias it (primary), for the token reference */
const role = new Map<string, string[]>();
for (const [n, e] of designColors) {
  const prop = tokenOf(live, "colors", n, e);
  if (!prop) continue;
  const named = tokenOf(live, "colors", n, { comment: e.comment }) === prop;
  role.set(prop, [...(role.get(prop) ?? []), named ? noteOf(e.comment) : n].filter(Boolean));
}
const typeLevels = groupsOf(design, "typography");
/* where DESIGN.md and tokens.css disagree: drift.mjs, the gate's own check (every color, radius, spacing
   and typography field), so the alert and the gate can never tell two stories */
const { drift, undocumented } = designDrift(designSrc, tokensCss);
/* the color a pair names: {colors.white} is "White" even when an earlier color shares its value
   (evie.life, tylers.life, marlowstreet, stagingpilot, advisorevolved.com read "Page on …") */
const refKey = (v: unknown) => (typeof v === "string" ? /^\{\s*colors\.([\w-]+)\s*\}$/.exec(v.trim())?.[1] : undefined);
const pairs = groupsOf(design, "components")
  .map(([n, p]) => ({ n, bg: resolveRef(design, p.backgroundColor), fg: resolveRef(design, p.textColor), bgKey: refKey(p.backgroundColor), fgKey: refKey(p.textColor) }))
  .filter((p): p is { n: string; bg: string; fg: string; bgKey: string | undefined; fgKey: string | undefined } => !!p.bg && !!p.fg && !p.bg.startsWith("{") && !p.fg.startsWith("{"));
const typeStyle = (p: Record<string, string>) => [["font-family", p.fontFamily], ["font-size", p.fontSize], ["font-weight", p.fontWeight], ["line-height", p.lineHeight], ["letter-spacing", p.letterSpacing]].filter(([, v]) => v).map(([k, v]) => `${k}:${v}`).join(";");
const siteName = textOf(design, "name") || "Discover Pluto";

const groups: [Kind, string][] = [
  ["color", "Color"], ["gradient", "Gradients"], ["font", "Font families"], ["size", "Type sizes"], ["weight", "Font weights"],
  ["leading", "Line heights"], ["tracking", "Letter spacing"], ["space", "Spacing & widths"], ["radius", "Radii"], ["shadow", "Shadows"], ["other", "Other tokens"],
];
const byKind = new Map(groups.map(([k]) => [k, tokens.filter((t) => kindOf(t) === k)]));

const classes = classesOf(globalCss);
const classSet = new Set(classes);
/* a modifier renders with its base (`btn-primary` / `btn--ghost` with `btn`) */
/* a class only ever written compounded with another (.btn.is-hover) renders with it */
const partners = new Map<string, string>();
for (const m of stripComments(globalCss).matchAll(/\.(-?[A-Za-z_][\w-]*)\.(-?[A-Za-z_][\w-]*)/g)) if (!partners.has(m[2])) partners.set(m[2], m[1]);
const withBase = (c: string) => {
  const base = classes.find((b) => b !== c && (c.startsWith(`${b}-`) || c.startsWith(`${b}_`)) && classSet.has(b));
  const with_ = base ?? (partners.has(c) && classSet.has(partners.get(c)!) ? partners.get(c) : undefined);
  return with_ ? `${with_} ${c}` : c;
};
const tagOf = (c: string) => (/btn|button|cta|link/i.test(c) ? "a" : "div");

/* the spec's palette: DESIGN.md's colors (each painted from the token it maps to), else every color token */
const palette = designSrc
  ? designColors.map(([n, e]) => ({ name: n, value: e.value, prop: tokenOf(live, "colors", n, e), note: noteOf(e.comment) }))
  : byKind.get("color")!.map((t) => ({ name: t.name, value: t.value, prop: t.name, note: "" }));
const spec = (section: string, prefix: string, kind: Kind) =>
  designSrc
    ? scalars(design, section).map(([n, e]) => ({ name: `${section}.${n}`, value: e.value, prop: tokenOf(live, section, n, e) ?? prefix + n }))
    : byKind.get(kind)!.map((t) => ({ name: t.name, value: t.value, prop: t.name }));
/* the corners: DESIGN.md's rounded scale, else every radius token (a --button-radius has no rounded.x) */
const roundedSpec = scalars(design, "rounded").length ? spec("rounded", "--radius-", "radius") : byKind.get("radius")!.map((t) => ({ name: t.name, value: t.value, prop: t.name }));
const fonts = byKind.get("font")!;
const shadows = byKind.get("shadow")!;
/* ---- THE BRAND BOOK (the page's opening chapters, for a designer): everything below is read from
   DESIGN.md and tokens.css, so a new site gets it with no hand-written content. Modelled on a
   traditional brand book: a cover, then Color (story + glossary with HEX / RGB / CMYK), Pairing
   (do's and don'ts computed from WCAG contrast), Typography (hierarchy + one specimen per family)
   and Logo. ---- */
const hexRgb = (hex: string) => { const h = norm(hex).replace("#", ""); return [0, 2, 4].map((i) => parseInt(h.slice(i, i + 2), 16)); };
const cmyk = ([r, g, b]: number[]) => {
  const [R, G, B] = [r / 255, g / 255, b / 255];
  const k = 1 - Math.max(R, G, B);
  if (k >= 1) return [0, 0, 0, 100];
  return [(1 - R - k) / (1 - k), (1 - G - k) / (1 - k), (1 - B - k) / (1 - k), k].map((v) => Math.round(v * 100));
};
const lumOf = (hex: string) => { const [r, g, b] = hexRgb(hex).map((x) => { const s = x / 255; return s <= 0.03928 ? s / 12.92 : ((s + 0.055) / 1.055) ** 2.4; }); return 0.2126 * r + 0.7152 * g + 0.0722 * b; };
const titleCase = (s: string) => s.replace(/[-_]+/g, " ").replace(/\b\w/g, (c) => c.toUpperCase());
/* the brand colors: DESIGN.md's SOLID colors (#rrggbb), one per token they map to (drift.mjs's tokenOf,
   the gate's own mapping), so two tokens that share a value stay two colors. A name with no token of
   its own (a role: primary, accent) labels the color whose value it aliases, and a token's own name
   takes the swatch (cascade-partners' "Primary · Primary · Accent", 2026-11-03). Translucent utilities
   (rules, scrims) stay in the spec. */
/* a token that only aliases another (`--color-primary: var(--color-accent)`) is that token's role, not
   a color of its own: evgnagency showed its olive three times, and blank 1:1 tiles (2026-11-03) */
const aliasTarget = (k: string) => { let t = k; for (let i = 0; i < 8; i++) { const m = /^var\(\s*(--[\w-]+)\s*\)$/.exec(live.get(t) ?? ""); if (!m || !live.has(m[1])) break; t = m[1]; } return t; };
const brandColors = (() => {
  const solid = designColors.filter(([, { value }]) => /^#[0-9a-f]{3}([0-9a-f]{3})?$/i.test(value.trim()));
  const byToken = new Map<string, { name: string; hex: string; note: string; roles: string[]; rank: number }>();
  for (const [n, e] of solid) {
    const own = tokenOf(live, "colors", n, e);
    const key = own ? aliasTarget(own) : norm(e.value);
    /* who names the swatch: the token's own name (--color-sand's `sand`), then a name its comment maps
       (`ocean  # = --teal`), then a role that only shares the value (`primary`) */
    const rank = tokenNames("colors", n).includes(key) ? 2 : tokenOf(live, "colors", n, { comment: e.comment }) ? 1 : 0;
    const c = byToken.get(key);
    if (!c) byToken.set(key, { name: n, hex: norm(e.value), note: noteOf(e.comment), roles: [], rank });
    else if (rank > c.rank) { c.roles.push(c.name); Object.assign(c, { name: n, note: noteOf(e.comment) || c.note, rank }); }
    else c.roles.push(n);
  }
  return [...byToken.values()].map((c) => ({ ...c, rgb: hexRgb(c.hex), cmyk: cmyk(hexRgb(c.hex)), lum: lumOf(c.hex) }));
})();
/* the cover's dots: one per color a reader tells apart. Colors closer than ΔE 12 (CIE76, in Lab) read
   as one at a glance (itspmagazine's two heading grays and four oranges, cascade-partners' 27 grays and
   teals), so the first in DESIGN.md's order stands for the rest. The Color chapter still shows every
   color (the person, 2026-11-03). */
const labOf = (hex: string) => {
  const [x, y, z] = (() => {
    const [r, g, b] = hexRgb(hex).map((v) => { const s = v / 255; return s <= 0.04045 ? s / 12.92 : ((s + 0.055) / 1.055) ** 2.4; });
    return [(0.4124 * r + 0.3576 * g + 0.1805 * b) / 0.95047, 0.2126 * r + 0.7152 * g + 0.0722 * b, (0.0193 * r + 0.1192 * g + 0.9505 * b) / 1.08883];
  })().map((t) => (t > 0.008856 ? Math.cbrt(t) : 7.787 * t + 16 / 116));
  return [116 * y - 16, 500 * (x - y), 200 * (y - z)];
};
const looksSame = (a: string, b: string) => { const p = labOf(a), q = labOf(b); return Math.hypot(p[0] - q[0], p[1] - q[1], p[2] - q[2]) < 12; };
/* the page's own ground wins a near-tie: one fleet site's off-white page lost its dot to a rose tint
   listed first (2026-11-11) */
const isGround = (c: { name: string; roles: string[] }) => [c.name, ...c.roles].some((x) => /^(page|surface|background|bg|paper|canvas)$/.test(x));
/* the dot that stands for a near-tie carries the names and roles of the colors it stands for, so a
   primary that ties with the page color still leads the Brand row (evgnagency.com lost its olive) */
const coverAlso = new Map<(typeof brandColors)[number], string[]>();
const coverKeep = [...brandColors].sort((a, b) => Number(isGround(b)) - Number(isGround(a))).reduce<typeof brandColors>((keep, c) => {
  const k = keep.find((x) => looksSame(x.hex, c.hex));
  if (!k) return [...keep, c];
  coverAlso.set(k, [...(coverAlso.get(k) ?? []), c.name, ...c.roles]);
  return keep;
}, []);
const coverDots = brandColors.filter((c) => coverKeep.includes(c)).map((c) => ({ ...c, roles: [...c.roles, ...(coverAlso.get(c) ?? [])] }));
const byLum = [...brandColors].sort((a, b) => a.lum - b.lum);
/* the ink, the cover's and the specimens' ground: a dark brand color, never a utility. The brand's
   `ink` if dark, else its primary if dark, else its most saturated dark color, else the darkest. The
   darkest alone picked a #000 button label (evgnagency), and a color named `text` picked body-copy
   gray over cascade-partners' navy (2026-11-03) */
const chroma = (c: { rgb: number[] }) => (Math.max(...c.rgb) - Math.min(...c.rgb)) / 255;
const dark = brandColors.filter((c) => c.lum < 0.18);
const isNamed = (c: { name: string; roles: string[] }, n: RegExp) => [c.name, ...c.roles].some((x) => n.test(x));
const inkColor = dark.find((c) => isNamed(c, /^(ink|dark)$/)) ?? dark.find((c) => isNamed(c, /^primary$/))
  ?? [...dark].filter((c) => chroma(c) >= 0.12).sort((a, b) => chroma(b) - chroma(a))[0] ?? byLum[0];
/* ...in rows, the colors that drive the brand first: its roles (primary, secondary, accent), then the
   other hues, then pale tints, then neutrals. Seventeen dots in one run read as a rainbow, not a brand
   (blinkpages.com, the person, 2026-11-04). In Lab: a color under C* 5, or named gray, muted or text
   and under C* 12, is a neutral (go.mvmlaw.com's slate is C* 18, a hue); a pale (L* 88+), soft (C* under 30) one a tint; then a mid or light one under
   C* 12 a neutral (tylers.life's #6b7280 is C* 8.6, blinkpages.com's pale sky 11.8). A dark navy
   reads as color at C* 8 (go.hilley-solis.com's), a near-black under C* 7 does not (raytrammell's
   ink, C* 5.5), and a role is a neutral only when it is a true gray (C* under 5). A brand with no role names leads with its first hue. */
