   (DESIGN.md.template's spacing comment, style-library.md §2b):
     "below this, …"    the level under it stops 1px short of it   (max-width: 777.98px for 778)
     "up to this, …"    the level under it includes it             (max-width: 767px); also "through this"
     "from this up, …"  the level over it starts at it             (min-width: 1025px)
   so a breakpoint's edge, the first width of the level over it, is its value, or its value + 1 "up to"
   it. Every breakpoint was read as "below" once, so one fleet site's max-width: 767px ruled 0–766. */
const BP_UPTO = /^\s*(up to|through|thru|max)\b/i, BP_BELOW = /^\s*(below|under|less than)\b/i, BP_FROM = /^\s*(from|above|over|at least|min)\b/i;
const bps = measures.filter((m) => m.kind === "bp" && m.px > 0).map((m) => {
  const side = BP_UPTO.test(m.note) ? "upto" : BP_BELOW.test(m.note) ? "below" : BP_FROM.test(m.note) ? "from" : "";
  return { ...m, side, edge: m.px + (side === "upto" ? 1 : 0), level: m.title.replace(/\s+(Max|Min|Up|Down)$/i, "") };
}).sort((a, b) => a.edge - b.edge);
const rulerMax = Math.max(1440, Math.ceil(((bps.at(-1)?.edge ?? 0) * 1.2) / 100) * 100);
const edgeOf = (px: number) => (px / rulerMax > 0.86 ? "end" : "");
/* a range takes a level's name from the breakpoint whose comment says it bounds that range: "below" or
   "up to" names the range under it, "from" the one over it. When every breakpoint names the range under
   it, the top range is Desktop (unless one is already); when every one names the range over it, the
   bottom range is Base */
const namesUnder = (b?: (typeof bps)[number]) => !!b && (b.side === "below" || b.side === "upto");
const bpAllUnder = bps.length > 0 && bps.every(namesUnder), bpAllOver = bps.length > 0 && bps.every((b) => b.side === "from");
const rulerRanges = bps.length ? [0, ...bps.map((b) => b.edge)].map((from, i, a) => ({
  from, to: a[i + 1] ?? rulerMax, last: i === a.length - 1,
  name: namesUnder(bps[i]) ? bps[i].level
    : bps[i - 1]?.side === "from" ? bps[i - 1].level
    : i === bps.length && bpAllUnder && !bps.some((b) => /desktop/i.test(b.title)) ? "Desktop"
    : i === 0 && bpAllOver ? "Base" : "",
})) : [];
/* device names, not the site's level names: a "Tablet" breakpoint and a 768px iPad are different things */
const DEVICES = [["phone", "iPhone", 390], ["tablet", "iPad", 768], ["laptop", "Laptop", 1280], ["desktop", "Desktop", 1440]] as const;
const KIND_LABEL: Record<MeasureKind, string> = { bp: "a breakpoint", container: "the container", gutter: "a gutter", height: "a height", pad: "a padding", width: "a width", gap: "a gap" };
/* everything else at actual size (shrunk to fit past 200px, and labelled so) */
const onArtboard = new Set<Measure | undefined>([container, gutter, headerBar]);
const actualSize = measures.filter((m) => !onArtboard.has(m) && m.kind !== "bp");
/* the largest each drawing can show at 1:1 in its tile: a padding twice beside its content, a gap between two blocks */
const fit = (m: Measure) => { const cap = m.kind === "pad" ? 64 : m.kind === "gap" || m.kind === "gutter" ? 110 : 200; return m.px > cap ? cap / m.px : 1; };
const padAxis = (n: string) => (/(^|-)(x|inline)(-|$)/.test(n) ? "x" : /(^|-)(y|block)(-|$)/.test(n) ? "y" : "both");
const pxNote = (m: Measure) => (/rem$/.test(m.value) && m.px > 0 ? ` · ${m.px}px` : "");
const layoutStory = proseOf(/^Layout/i);
const depthStory = proseOf(/^Elevation/i);
const shapeStory = proseOf(/^Shapes?\b/i);
const componentStory = proseOf(/^Components/i);
/* Do's and Don'ts, split for the last chapter's two columns. Three forms are read: bullets that start
   "Do …" / "Don't …"; bullets under a **Do** / **Don't** line (one fleet site); bullets under a
   ### Do / ### Don't subhead. A bullet's own "Do" or "Don't" wins over the line above it, and is
   dropped, as its column says it. Anything else (a paragraph, a table) is set after the columns. */
const doList: string[] = [], dontList: string[] = [], dosOther: Prose[] = [];
{
  const plain = (html: string) => html.replace(/<[^>]+>/g, "").trim();
  const DO_HEAD = /^do(?:['’]?s)?\s*:?$/i, DONT_HEAD = /^(?:don['’]?ts?|do not|avoid)\s*:?$/i;
  const DONT_LEAD = /^(?:don['’]?t|do not)\b/i, DO_LEAD = /^do\b(?!['’]?s?\s*:?$)/i;
  const drop = (h: string) => h.replace(/^(?:<(strong|em)>\s*(?:don['’]?t|do not|do)\s*[:.]?\s*<\/\1>|(?:don['’]?t|do not|do)\b)[\s:,.—–-]*/i, "").replace(/^[a-z]/, (c) => c.toUpperCase());
  let side: "" | "do" | "dont" = "";
  for (const b of dosDonts) {
    if (b.kind === "h" || b.kind === "p") {
      const t = plain(b.html);
      if (DONT_HEAD.test(t)) { side = "dont"; continue; }
      if (DO_HEAD.test(t)) { side = "do"; continue; }
    }
    if (b.kind === "list") {
      const rest = b.items.filter((h) => {
        const t = plain(h), s = DONT_LEAD.test(t) ? "dont" : DO_LEAD.test(t) ? "do" : side;
        if (s) (s === "do" ? doList : dontList).push(DONT_LEAD.test(t) || DO_LEAD.test(t) ? drop(h) : h);
        return !s;
      });
      if (rest.length) dosOther.push({ ...b, items: rest });
    } else dosOther.push(b);
  }
}
/* the pairs the site uses (DESIGN.md components), each named and scored: a translucent text color is
   laid over its ground first; a translucent ground has no one ratio, as it depends on what shows through */
const rgbaOf = (c: string) => { if (/^transparent$/i.test(c.trim())) return [0, 0, 0, 0]; const m = c.match(/rgba?\(\s*([\d.]+)[ ,]+([\d.]+)[ ,]+([\d.]+)(?:[ ,/]+([\d.]+))?/); return m ? [+m[1], +m[2], +m[3], m[4] === undefined ? 1 : +m[4]] : [...hexRgb(c), 1]; };
const colorName = (v: string) => titleCase(brandColors.find((c) => norm(c.hex) === norm(v))?.name ?? designColors.find(([, x]) => norm(x.value) === norm(v))?.[0] ?? v);
const pairsInUse = pairs.map((p) => {
  const [fr, fg, fb, fa] = rgbaOf(p.fg), [br, bg, bb, ba] = rgbaOf(p.bg);
  const mix = (f: number, g: number) => Math.round(f * fa + g * (1 - fa));
  const ratio = ba < 1 ? null : contrast(`rgb(${mix(fr, br)}, ${mix(fg, bg)}, ${mix(fb, bb)})`, `rgb(${br}, ${bg}, ${bb})`);
  /* a pair whose text can't be read on its ground (under 1.5:1) still names itself, in a color that can */
  const label = ratio !== null && ratio < 1.5 ? (contrast(bbInk, `rgb(${br}, ${bg}, ${bb})`) >= contrast(bbPaper, `rgb(${br}, ${bg}, ${bb})`) ? bbInk : bbPaper) : p.fg;
  return { ...p, ratio, label, fgName: p.fgKey ? titleCase(p.fgKey) : colorName(p.fg), bgName: p.bgKey ? titleCase(p.bgKey) : colorName(p.bg) };
});
const verdictOf = (r: number | null) => (r === null ? "a translucent ground: no single ratio" : `${r.toFixed(1)}:1 · ${r >= 4.5 ? "AA" : r >= 3 ? "large text only" : "below AA"}`);

/* ---- THE COMPONENT EXPLORER (Storybook-style): stories.ts's stories, expanded by explorer.ts, both in
   src/components/design-system/ (a glob, so a site without them still builds). Each story renders
   on its own page under /design-system/story/, which the explorer frames. ---- */
type SxEntry = { slug: string; title: string; group: string; stories: { slug: string; name: string }[] };
const sxMod = Object.values(import.meta.glob<{ explorer: () => SxEntry[] }>("../components/design-system/explorer.ts", { eager: true }))[0];
const sx = sxMod?.explorer() ?? [];
const sxGroups = [...sx.reduce((m, e) => m.set(e.group, [...(m.get(e.group) ?? []), e]), new Map<string, SxEntry[]>())];
/* a build.format "file" site serves a story at /design-system/story/<id> (its <id>.html): a trailing
   slash 404s under astro preview and redirects once in production (electriccollab.com, agencydonebetter.com) */
const storyTail = (() => {
  for (const f of ["astro.config.mjs", "astro.config.ts", "astro.config.mts"]) {
    const p = path.join(process.cwd(), f);
    if (fs.existsSync(p)) return /\bformat\s*:\s*["']file["']/.test(fs.readFileSync(p, "utf8")) ? "" : "/";
  }
  return "/";
})();
const sxData = JSON.stringify({ base: "/design-system/story/", tail: storyTail, entries: sx }).replace(/</g, "\\u003c");
const sxViewports: [string, string, string][] = [["fit", "Fit", ""], ["phone", "iPhone", "390"], ["tablet", "iPad", "768"], ["desktop", "Desktop", "1440"]];

/* the appendix, lettered in order: Blocks only on an older page that still has block cards */
const appendix: [string, string][] = [...(slBlockGroups.length ? [["blocks", "Blocks"] as [string, string]] : []), ["page-specific", "Not in the explorer"], ["tokens", "Token reference"], ["classes", "Global classes"]];
const letterOf = (id: string) => String.fromCharCode(65 + appendix.findIndex(([a]) => a === id));

const nav: [string, [string, string][]][] = [
  ["Brand book", [["cover", "Cover"], ["logo", "01 Logo & icon"], ["colors", "02 Color"], ["typography", "03 Typography"], ["layout", "04 Layout"], ["depth", "05 Depth & shape"], ["components", "06 Components"], ...(dosDonts.length ? [["dos", "07 Do's & don'ts"] as [string, string]] : [])]],
  ["Appendix", appendix.map(([id, label]) => [id, `${letterOf(id)}. ${label}`] as [string, string])],
];
