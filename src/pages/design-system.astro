      .sx-cell-name { color: #4b5563; font-size: .6875rem; font-weight: 600; letter-spacing: .08em; text-transform: uppercase; }
      .sx-tabs { display: flex; gap: .25rem; padding: 0 1rem; border-top: 1px solid #e5e5e5; border-bottom: 1px solid #e5e5e5; }
      .sx-tabs button { padding: .625rem .75rem; border: 0; border-bottom: 2px solid transparent; background: none; color: #6b7280; font: inherit; font-size: .8125rem; font-weight: 600; cursor: pointer; }
      .sx-tabs button[aria-selected="true"] { border-bottom-color: var(--bb-accent, #1d4ed8); color: var(--bb-ink, #111); }
      .sx-panel { min-height: 8rem; overflow-x: auto; padding: 1rem 1.25rem 1.25rem; font-size: .875rem; }
      .sx-table { width: 100%; border-collapse: collapse; }
      .sx-table th { padding: .375rem .5rem; border-bottom: 1px solid #e5e5e5; color: #6b7280; font-size: .6875rem; font-weight: 600; letter-spacing: .06em; text-align: left; text-transform: uppercase; }
      .sx-table tbody th { width: 12rem; color: #111; font-size: .8125rem; letter-spacing: 0; text-transform: none; }
      .sx-table td { padding: .5rem; border-bottom: 1px solid #f0f0f0; vertical-align: top; }
      .sx-table code, .sx-code { font: .75rem/1.5 ui-monospace, SFMono-Regular, Menlo, monospace; }
      .sx-table input[type="text"], .sx-table select { box-sizing: border-box; width: 100%; max-width: 22rem; padding: .35rem .5rem; border: 1px solid #d1d5db; border-radius: 4px; font: inherit; }
      .sx-note { margin: .75rem 0 0; color: #6b7280; font-size: .8125rem; }
      .sx-codebox { position: relative; }
      .sx-code { margin: 0; padding: 1rem 5rem 1rem 1rem; overflow-x: auto; border-radius: 6px; background: #111827; color: #e5e7eb; font-size: .8125rem; white-space: pre-wrap; word-break: break-word; }
      .sx-copy { position: absolute; top: .5rem; right: .5rem; padding: .25rem .625rem; border: 1px solid #4b5563; border-radius: 4px; background: #1f2937; color: #e5e7eb; font: inherit; font-size: .75rem; cursor: pointer; }
      .sx-used { margin: 0; padding-left: 1.2em; line-height: 1.8; }
      @media (max-width: 900px) {
        .sx { grid-template-columns: minmax(0, 1fr); }
        .sx-side { max-height: 15rem; border-right: 0; border-bottom: 1px solid #e5e5e5; }
        .sx-canvas { padding: .75rem; }
        .sx-open { margin-left: 0; }
      }
      /* a phone: the device switch drops its widths so it fits beside the background swatches */
      @media (max-width: 600px) {
        .sx-seg button span { display: none; }
      }
    </style>
  </head>
  <!-- out of the site's search: a site that runs Pagefind after its build would put this editor-only
       page in its public index (cascade-partners: 80 design-system pages, 2026-11-03) -->
  <body data-pagefind-ignore="all">
    <div class="sl" style={`--bb-display:${bbDisplay};--bb-text:${bbText};--bb-ink:${bbInk};--bb-paper:${bbPaper};--bb-accent:${bbAccent}`}>
      <nav class="sl-nav" aria-label="Design system contents">
        <a class="sl-nav-home" href="#top">{siteName}</a>
        {nav.map(([label, items]) => (
          <Fragment>
            <p class="sl-nav-label">{label}</p>
            {items.map(([id, text]) => (
              <Fragment>
                <a href={`#${id}`} data-sl-nav={id}>{text}</a>
                {id === "blocks" && slBlockGroups.length > 0 && <div class="sl-nav-sub">{slBlockGroups.map(([g, l]) => <a href={`#${g}`}>{l}</a>)}</div>}
              </Fragment>
            ))}
          </Fragment>
        ))}
      </nav>

      <main class="sl-main" id="top">

        {/* ========================================== THE BOOK, in DESIGN.md's order (generated) == */}
        <article class="bb" aria-label="Brand book and design system">
          <header class="bb-cover" id="cover">
            <p class="bb-kicker">Brand book · Design system</p>
            <h1 class="bb-title">{siteName}</h1>
            {textOf(design, "description") && <p class="bb-cover-lede">{textOf(design, "description")}</p>}
            <div class="bb-dot-rows">{coverRows.map(([label, cs], i) => (
              <div class={i === 0 ? "bb-dot-row bb-dot-row--lead" : "bb-dot-row"}><p class="bb-dot-label">{label === "Brand" ? label : `${label}s`}</p><ul class="bb-dots" aria-label={`${label} colors`}>{cs.map((c) => <li style={`background:${c.hex}`} title={titleCase(c.name)} />)}</ul></div>
            ))}</div>
            {coverMark && <img class={coverMarkClass} src={coverMark.src} alt="" width="72" height="72" />}
          </header>
          {!designSrc ? (
            <p class="sl-note sl-note--alert bb-alert">No <code>DESIGN.md</code> at the repo root yet, so this book falls back to the raw tokens. Write it from the scaffold's template (style-library.md §2b).</p>
          ) : drift.length > 0 ? (
            <div class="sl-note sl-note--alert bb-alert" role="status"><strong>DESIGN.md and tokens.css disagree.</strong> Fix one to match the other:<ul>{drift.map((d) => <li><code>{d}</code></li>)}</ul></div>
          ) : null}
          <div class="bb-intro">
            {overview.length > 0 && <Fragment><p class="bb-label">Overview</p><div class="bb-prose" set:html={proseHtml(overview)} /></Fragment>}
            <p class="bb-source">
              Generated from <code>DESIGN.md</code>, the design spec at the root of the site's code, and from the code itself: in
              DESIGN.md's order, in the site's own fonts and colors. Each chapter opens with the spec's own words. "For developers",
              at the foot of a chapter, gives its tokens and classes, and the appendix lists all of them.{designSrc && drift.length === 0 && " DESIGN.md and tokens.css are in step."}
            </p>
          </div>

          <section class="bb-chapter" id="logo">
            <header class="bb-divider" style={`background:${bbAccent};color:${bbInk}`}><span class="bb-num">01</span><h2 class="bb-h">Logo &amp; icon</h2></header>
            {logoStory.length > 0 && <div class="bb-story"><div class="bb-prose" set:html={proseHtml(logoStory)} /></div>}
            <div class="bb-marks">
              {marks.map((m) => (
                <figure class:list={["bb-mark", m.small && "bb-mark--small"]} style={m.ground === "ink" ? `background:${bbInk};color:${bbPaper};color-scheme:dark` : `background:${bbPaper};color:${bbInk};color-scheme:light`}>
                  <img src={m.src} alt="" loading="lazy" />
                  <figcaption>{m.icon ? "Site icon · the browser tab and a phone's home screen" : `${m.name} · on ${groundName(m.ground)}`}</figcaption>
                </figure>
              ))}
              {/* sl:logos — the site's logo variants (the header logo, a light / dark version, the icon), each a
                    <figure class="bb-mark" style="background:…"><img or <Logo /> /><figcaption>Primary logo · on Cream</figcaption></figure>
                    with one line on when to use it. Render the real component or file, never a redrawn copy. */}
              {/* the site has no logo file or icon: its mark is the header's wordmark, the global .brand class */}
              <figure class="bb-mark" style="background:var(--space-black);color:var(--paper);color-scheme:dark">
                <span class="brand sl-wordmark">Discover&nbsp;Pluto</span>
                <figcaption>Wordmark · on Space Black, in the header of every page. The site's only mark</figcaption>
              </figure>
            </div>
            {marksMore.length > 0 && <p class="bb-footnote">Also in the brand files: {marksMore.join(", ")}.</p>}
          </section>

          <section class="bb-chapter" id="colors">
            <header class="bb-divider" style={`background:${bbInk};color:${bbPaper}`}><span class="bb-num">02</span><h2 class="bb-h">Color</h2></header>
            {colorStory.length > 0 && <div class="bb-story"><div class="bb-prose" set:html={proseHtml(colorStory)} /></div>}
            {brandColors.length > 0 ? (
              <Fragment>
                <div class="bb-palette">
                  {brandColors.map((c) => (
                    <figure class="bb-swatch">
                      <div class="bb-swatch-chip" style={`background:${c.hex}`} />
                      <figcaption>
                        <p class="bb-swatch-name">{titleCase(c.name)}{c.roles.length > 0 && <span class="bb-swatch-role"> · {c.roles.map(titleCase).join(" · ")}</span>}</p>
                        {c.note && <p class="bb-swatch-note">{plainNote(c.note)}</p>}
                        <dl class="bb-codes">
                          <dt>HEX</dt><dd>{c.hex.toUpperCase()}</dd>
                          <dt>RGB</dt><dd>{c.rgb.join(", ")}</dd>
                          <dt>CMYK</dt><dd>{c.cmyk.join(", ")}</dd>
                        </dl>
                      </figcaption>
                    </figure>
                  ))}
                </div>
                <p class="bb-footnote">Screens use HEX and RGB. CMYK is a straight conversion for print: confirm it on a proof, or match a Pantone, before a print run.</p>
              </Fragment>
            ) : (
              <div class="bb-body">
                <div class="sl-swatches">
                  {palette.map((c) => (
                    <figure class="sl-swatch">
                      <div class="sl-chip"><span style={`background:${c.prop ? `var(${c.prop})` : c.value}`} /></div>
                      <figcaption><strong>{c.name}</strong><code class="sl-code">{c.value}</code>{c.note && <span class="sl-role">{c.note}</span>}</figcaption>
                    </figure>
                  ))}
                </div>
              </div>
            )}
            <div class="bb-pair-cols">
              <div>
                <p class="bb-label">{pairsInUse.length ? "Pairs in use" : "Do"}</p>
                <p class="bb-small">{pairsInUse.length ? "Every text-on-color pair the site uses, with its contrast. WCAG AA asks 4.5:1 of body text and 3:1 of large text." : "Text in one brand color on another, with enough contrast to read (WCAG AA, 4.5:1 and up)."}</p>
                <ul class="bb-pairs">
                  {pairsInUse.length > 0
                    ? pairsInUse.map((p) => <li style={`background:${p.bg};color:${p.label}`}><b style={`color:${p.fg}`}>Aa</b><span class="bb-pair-name">{titleCase(p.n)}</span><span>{p.fgName} on {p.bgName}</span><span>{verdictOf(p.ratio)}</span></li>)
                    : dos.map((p) => <li style={`background:${p.ground.hex};color:${p.ink.hex}`}><b>Aa</b><span>{titleCase(p.ink.name)} on {titleCase(p.ground.name)}</span><span>{p.ratio.toFixed(1)}:1</span></li>)}
                </ul>
              </div>
              <div>
                <p class="bb-label">Don't</p>
                <p class="bb-small">Brand colors too close in lightness to carry text (under 3:1): never set one on the other.</p>
                <ul class="bb-pairs bb-pairs--dont">{donts.map((p) => <li style={`background:${p.ground.hex};color:${p.ink.hex}`}><b>Aa</b><span>{titleCase(p.ink.name)} on {titleCase(p.ground.name)}</span><span>{p.ratio.toFixed(1)}:1</span></li>)}</ul>
              </div>
            </div>
            <details class="bb-dev">
              <summary>For developers<span>the color tokens</span></summary>
              <div class="bb-dev-scroll">
                <table class="bb-dev-table">
                  <thead><tr><th>DESIGN.md</th><th>Token</th><th>Value</th><th>Role</th></tr></thead>
                  <tbody>{palette.map((c) => <tr><td><span class="bb-dev-chip" style={`background:${c.prop ? `var(${c.prop})` : c.value}`} />{c.name}</td><td>{c.prop ? <code>{c.prop}</code> : "—"}</td><td><code>{c.value}</code></td><td>{c.note}</td></tr>)}</tbody>
                </table>
              </div>
              {designSrc && undocumented.length > 0 && <p class="sl-note">In tokens.css but not DESIGN.md: <code>{undocumented.join(", ")}</code>. Document each, or remove it if nothing uses it.</p>}
            </details>
          </section>

          <section class="bb-chapter" id="typography">
            <header class="bb-divider" style={`background:${bbAccent};color:${bbInk}`}><span class="bb-num">03</span><h2 class="bb-h">Typography</h2></header>
            {typeStory.length > 0 && <div class="bb-story"><div class="bb-prose" set:html={proseHtml(typeStory)} /></div>}
            <p class="bb-label bb-inset" style="margin-top:clamp(2.5rem, 5vw, 4rem)">Hierarchy</p>
            {typeLevels.length > 0 ? (
              <ol class="bb-hier">
                {typeLevels.map(([n, p]) => (
                  <li>
                    <p class="bb-hier-label">{titleCase(n)}<span>{familyOf(p)} · {[p.fontSize, p.lineHeight].filter(Boolean).join(" / ")}{p.fontWeight && ` · ${p.fontWeight}`}</span></p>
                    <p class="bb-hier-sample" style={bbSampleStyle(p)}>The quick brown fox jumps over the lazy dog</p>
                    {typeNotes.get(n) && <p class="bb-small">{plainNote(typeNotes.get(n))}</p>}
                  </li>
                ))}
              </ol>
            ) : (
              <div class="bb-body">
                <div class="sl-rows">
                  {byKind.get("size")!.map((t) => (
                    <div class="sl-row">
                      <div><code class="sl-code">{t.name}</code><code class="sl-code">{t.value}</code></div>
                      <div class="sl-sample-text" style={`font-size:var(${t.name});line-height:1.2`}>The quick brown fox</div>
                    </div>
                  ))}
                </div>
              </div>
            )}
            {families.map((f, i) => (
              <article class="bb-specimen" style={`background:${i % 2 ? bbAccent : bbInk};color:${i % 2 ? bbInk : bbPaper}`}>
                <p class="bb-specimen-name" style={`font-family:${f.stack}`}>{f.family}</p>
                <p class="bb-specimen-glyphs" style={`font-family:${f.stack}`}>ABCDEFGHIJKLMNOPQRSTUVWXYZ<br />abcdefghijklmnopqrstuvwxyz<br />0123456789 &amp; ? ! @ # % ( ) “ ”</p>
                <div class="bb-specimen-cols">
                  <div>
                    <p class="bb-label">Weights</p>
                    <ul class="bb-weights">{[...f.weights].sort().map((w) => <li style={`font-family:${f.stack};font-weight:${w}`}>{w} — The quick brown fox</li>)}</ul>
                  </div>
                  <div>
                    <p class="bb-label">Sets</p>
                    <ul class="bb-usage">{f.roles.map((r) => <li><strong>{titleCase(r.name)}</strong> · {[r.p.fontSize, r.p.fontWeight].filter(Boolean).join(" · ")}</li>)}</ul>
                  </div>
                </div>
              </article>
            ))}
            <details class="bb-dev">
              <summary>For developers<span>the type tokens and text classes</span></summary>
              <div class="bb-dev-scroll">
                <table class="bb-dev-table">
                  <thead><tr><th>Level</th><th>Token</th><th>Family</th><th>Size / line</th><th>Weight</th><th>Tracking</th></tr></thead>
                  <tbody>{typeLevels.map(([n, p]) => <tr><td>{n}</td><td>{tokenOf(live, "fontSize", n) ? <code>{tokenOf(live, "fontSize", n)}</code> : "—"}</td><td>{familyOf(p)}</td><td>{[p.fontSize, p.lineHeight].filter(Boolean).join(" / ")}</td><td>{p.fontWeight ?? ""}</td><td>{p.letterSpacing ?? ""}</td></tr>)}</tbody>
                </table>
              </div>
              {fonts.length > 0 && (
                <div class="bb-dev-scroll">
                  <table class="bb-dev-table">
                    <thead><tr><th>Family token</th><th>Stack</th></tr></thead>
                    <tbody>{fonts.map((t) => <tr><td><code>{t.name}</code></td><td><code>{t.value}</code></td></tr>)}</tbody>
                  </table>
                </div>
              )}
              {/* sl:typography — the site's heading and text classes, under an <h3 class="sl-fig-name">, one row each:
                    <div class="sl-row"><code class="sl-code">.section-h2</code><h2 class="section-h2">Sample heading</h2></div> */}
              <h3 class="sl-fig-name">Text classes</h3>
              <div class="sl-rows">
                <div class="sl-row"><div><code class="sl-code">.brand</code><span class="sl-row-note">the wordmark, on {tok("--space-black")}</span></div><div class="sl-type-ground" style="background:var(--space-black);color:var(--paper)"><span class="brand">Sample Name</span></div></div>
                <div class="sl-row"><div><code class="sl-code">.hero-tagline</code><span class="sl-row-note">the hero's welcome line, on {tok("--space-deep")}</span></div><div class="sl-type-ground" style="background:var(--space-deep)"><p class="hero-tagline">A one-line welcome in sample copy.</p></div></div>
                <div class="sl-row"><div><code class="sl-code">.year</code><span class="sl-row-note">a timeline's year, {tok("--accent-ink")}</span></div><div><span class="year">1930</span> Sample event copy.</div></div>
              </div>
            </details>
          </section>

          <section class="bb-chapter" id="layout">
            <header class="bb-divider" style={`background:${bbInk};color:${bbPaper}`}><span class="bb-num">04</span><h2 class="bb-h">Layout</h2></header>
            {layoutStory.length > 0 && <div class="bb-story"><div class="bb-prose" set:html={proseHtml(layoutStory)} /></div>}
            <div class="bb-body">
              {art && container && (
                <figure class="sl-fig">
                  <h3 class="sl-fig-name">Page grid · a {art.W}px desktop artboard, drawn to scale</h3>
                  <div class="sl-art" style={`aspect-ratio:${art.W}/${art.H}`}>
                    {headerBar && (
                      <div class="sl-art-header" style={`height:${art.header}`}>
                        <span class="sl-dim sl-dim--v" style={`left:calc(${art.side} / 2)`} />
                        <span class="sl-art-label" style={`left:${art.side}`}>{headerBar.title} · {headerBar.value}</span>
                      </div>
                    )}
                    <div class="sl-art-margin" style={`top:${art.header};width:${art.side}`}><span class="sl-dim sl-dim--soft"><span>auto</span></span></div>
                    <div class="sl-art-container" style={`top:${art.header};left:${art.side};width:${art.width}`}>
                      <span class="sl-dim sl-art-cdim"><span>{container.value}</span></span>
                      {gutter && <div class="sl-art-gutter" style={`left:0;width:${art.gutter}`}><span class="sl-dim"><span>{gutter.px}</span></span></div>}
                      {gutter && <div class="sl-art-gutter" style={`right:0;width:${art.gutter}`}><span class="sl-dim"><span>{gutter.px}</span></span></div>}
                      <div class="sl-art-content" style={`left:${art.gutter};right:${art.gutter}`} aria-hidden="true"><i class="sl-art-k" /><i class="sl-art-h" /><i class="sl-art-t" /><i class="sl-art-c1" /><i class="sl-art-c2" /></div>
                    </div>
                  </div>
                  <span class="sl-dim sl-art-total"><span>{art.W}px</span></span>
                  <figcaption>
                    <dl class="sl-legend">
                      {[container, gutter, headerBar].filter((m): m is Measure => !!m).map((m) => (
                        <Fragment><dt>{m.title}<span>{m.value}{pxNote(m)}</span></dt><dd>{m.note}</dd></Fragment>
                      ))}
                      <dt>Outer margin<span>auto</span></dt><dd>Whatever is left either side once the container stops growing ({art.margin}px each side on this artboard).</dd>
                    </dl>
                  </figcaption>
                </figure>
              )}
              {bps.length > 0 && (
                <figure class="sl-fig">
                  <h3 class="sl-fig-name">Breakpoints · screen width 0 to {rulerMax}px, to scale</h3>
                  <div class="sl-ruler" style={`--tick:${pct(100, rulerMax)}`}>
                    <div class="sl-ruler-marks">
                      {bps.map((b, i) => <span class="sl-mark" data-row={i % 2} data-edge={edgeOf(b.edge)} style={`left:${pct(b.edge, rulerMax)}`}><span>{namesUnder(b) || b.side === "from" ? `${b.px}px` : <Fragment><b>{b.title}</b> {b.px}</Fragment>}</span></span>)}
                    </div>
                    <div class="sl-ruler-bar">
                      {rulerRanges.map((r, i) => <span class="sl-range" data-alt={i % 2} style={`left:${pct(r.from, rulerMax)};width:${pct(r.to - r.from, rulerMax)}`}>{r.name && <b>{r.name}</b>}{r.last ? `${r.from}+` : `${r.from}–${r.to - 1}`}</span>)}
                      {bps.map((b) => <i class="sl-ruler-line" style={`left:${pct(b.edge, rulerMax)}`} />)}
                    </div>
                    <div class="sl-ruler-devices">
                      {DEVICES.filter(([, , w]) => w <= rulerMax).map(([k, label, w], i) => <span class="sl-mark sl-mark--device" data-row={i % 2} data-edge={edgeOf(w)} style={`left:${pct(w, rulerMax)}`}><span><i class={`sl-device sl-device--${k}`} /><span class="sl-device-name">{label} </span>{w}</span></span>)}
                    </div>
                  </div>
                  <figcaption>
                    <dl class="sl-legend">
                      {bps.map((b) => <Fragment><dt>{b.title}<span>{b.value}{pxNote(b)}</span></dt><dd>{b.note}</dd></Fragment>)}
                    </dl>
                    <p class="sl-hint">Above the ruler: the site's breakpoints. Below: common device widths, the artboards to design at.</p>
                  </figcaption>
                </figure>
              )}
              {actualSize.length > 0 && (
                <Fragment>
                  <h3 class="sl-fig-name">Sizes and spacing · actual size</h3>
                  <div class="sl-measures">
                    {actualSize.map((m) => {
                      const s = fit(m), d = Math.round(m.px * s);
                      const axis = padAxis(m.n);
                      return (
                        <figure class="sl-measure">
                          <div class="sl-measure-stage">
                            {!(m.px > 0) ? <span class="sl-measure-fluid">{m.value}</span>
                              : m.kind === "height" ? <div class="sl-m-height" style={`height:${d}px`}><span class="sl-dim sl-dim--v" /></div>
                              : m.kind === "pad" ? <div class="sl-m-pad" style={`padding:${axis === "y" ? `${d}px 0` : axis === "x" ? `0 ${d}px` : `${d}px`}`}><span>Content</span></div>
                              : m.kind === "width" || m.kind === "container" ? <div class="sl-m-width" style={`width:${d}px`}><span class="sl-dim" /></div>
                              : <div class="sl-m-gap"><i /><span style={`width:${d}px`}><span class="sl-dim" /></span><i /></div>}
                          </div>
                          <figcaption>
                            <strong>{m.title}</strong> <span class="sl-measure-val">{m.value}{pxNote(m)}{s < 1 && ` · shown at 1:${Math.round(1 / s * 10) / 10}`}</span>
                            {m.note && <span class="sl-measure-note">{m.note}</span>}
                          </figcaption>
                        </figure>
                      );
                    })}
                  </div>
                </Fragment>
              )}
            </div>
            <details class="bb-dev">
              <summary>For developers<span>the spacing tokens and the container class</span></summary>
              <div class="bb-dev-scroll">
                <table class="bb-dev-table">
                  <thead><tr><th>DESIGN.md</th><th>Token</th><th>Value</th><th>Drawn as</th></tr></thead>
                  <tbody>{measures.map((m) => <tr><td>{designSrc ? `spacing.${m.n}` : "—"}</td><td><code>{m.prop}</code></td><td><code>{m.value}</code></td><td>{KIND_LABEL[m.kind]}</td></tr>)}</tbody>
                </table>
              </div>
              {/* sl:layout — the site's real container and grid classes, live (the drawings above are generated):
                    <div class="sl-stage"><div class="container">…</div></div>, and how a row stacks at each breakpoint */}
              <h3 class="sl-fig-name">The reading column</h3>
              <p class="sl-note">The site has no container class and no grid. Every page's column is its <code>main</code> element, styled by that element's rule in global.css, and the header and footer are full-width bands. Nothing stacks: there are no breakpoints. Open any story in the Content group of the explorer to see a block in the real column.</p>
            </details>
          </section>

