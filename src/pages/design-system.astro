      .sl-h3 { margin: 2rem 0 .75rem; color: inherit; font: 600 1.125rem/1.3 var(--bb-text, system-ui, sans-serif); letter-spacing: normal; text-transform: none; scroll-margin-top: 1rem; }
      /* ---- the brand book ---- */
